#!/usr/bin/env bash
# shared preamble for the role launchers: sync, resolve role file, sanity-check the clone,
# stamp commits with the seat, run
# usage: _start <role> <role-file-basename> <cmd...>   ("ROLEFILE" in cmd is replaced)
set -uo pipefail
role="$1"; rolefile="$2"; shift 2
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT"
SKILL="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# 60-minute Bash tool cap so wait-for / po-wait can block for 55 minutes: every empty poll
# that returns to the model is a full turn, and idle polling was most of the usage.
export BASH_MAX_TIMEOUT_MS="${BASH_MAX_TIMEOUT_MS:-3600000}"

here="$(basename "$PWD")"
case "$here" in
  "$role"|"$role"-[0-9]*) ;;
  *) echo "warning: starting the $role in clone '$here' — each role should have its own clone" >&2 ;;
esac

git pull -q --rebase --autostash 2>/dev/null || echo "warning: git pull failed — check the remote before working" >&2
git submodule update -q --init --recursive 2>/dev/null || true

# Seat: whose subscription this run is billed to (first key under `seats:` in .team/team.md).
# Every commit from this clone gets a `Seat: <name>` trailer via a prepare-commit-msg hook.
seat="$(awk '/^seats:/{f=1;next} f&&/^[^ #]/{exit} f&&/^  [A-Za-z0-9_-]+:/{sub(/^  /,"");sub(/:.*/,"");print;exit}' .team/team.md 2>/dev/null)"
if [ -n "$seat" ]; then
  "$SKILL/bin/seat-hook" install "$seat" || echo "warning: could not install the Seat trailer hook" >&2
fi

# project override wins over the submodule's role file (keep overrides empty: project
# specifics belong in AGENTS.md § Team settings, so upgrades of the team reach the project)
if [ -f ".team/roles/$rolefile" ]; then
  RF=".team/roles/$rolefile"
  echo "note: using project override .team/roles/$rolefile" >&2
else
  RF="$SKILL/team/roles/$rolefile"
fi

args=()
for a in "$@"; do args+=("${a//ROLEFILE/$RF}"); done
exec "${args[@]}"
