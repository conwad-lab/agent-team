#!/usr/bin/env bash
# Vercel: exit 0 skips the build; exit 1 builds. Run from the project root.
set -u

build() {
  echo "Build: $1"
  exit 1
}

case "${VERCEL_ENV:-}" in
  production | preview) ;;
  *) build "unknown deployment environment" ;;
esac

BASE=${VERCEL_GIT_PREVIOUS_SHA:-}
HEAD_SHA=${VERCEL_GIT_COMMIT_SHA:-}
for revision in "$BASE" "$HEAD_SHA"; do
  [[ "$revision" =~ ^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$ ]] || build "missing or invalid revision"
  [[ "$revision" =~ ^0+$ ]] && build "zero revision"
  if ! git cat-file -e "$revision^{commit}" 2>/dev/null; then
    git fetch --depth=1 origin "$revision" >/dev/null 2>&1 || build "revision unavailable"
    git cat-file -e "$revision^{commit}" 2>/dev/null || build "revision unavailable"
  fi
done

DIFF_FILE=$(mktemp) || build "cannot create diff file"
trap 'rm -f "$DIFF_FILE"' EXIT
if git diff --name-only --no-renames -z "$BASE" "$HEAD_SHA" > "$DIFF_FILE" 2>/dev/null; then
  [[ -s "$DIFF_FILE" ]] || build "empty diff"
  while IFS= read -r -d '' path; do
    [[ "$path" == .team/* ]] || build "changes outside .team/"
  done < "$DIFF_FILE"
  echo "Skip: only .team/ changed"
  exit 0
fi
echo "Build: cannot read diff"
exit 1
