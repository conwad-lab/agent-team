#!/usr/bin/env bash
# Block until the Product Owner has something to do.
#   exit 0  the board has a row in the PO's lane (needs-split, escalated not yet written up),
#           or the board is idle and .team/ORDER.md has an unchecked row — prints which
#   exit 1  after MAX seconds — nothing yet; run again
#   exit 2  board unreliable (gh / network) — tell the human, do not loop
# usage: po-wait [MAX seconds, default 3300] [POLL seconds, default 120]
# "Idle" = no story in flight. That is a WIP limit of one story: the next order row is taken
# only when the last one is merged. Parked stories (needs-split) do not count as in flight;
# an escalated story does — it waits for the human.
set -uo pipefail
max="${1:-3300}"; every="${2:-120}"
cd "$(git rev-parse --show-toplevel)" || exit 1
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
t=0
while :; do
  git pull -q --rebase --autostash 2>/dev/null || true
  err="$(mktemp)"; rows="$("$BIN/status" --tsv 2>"$err")"; warn="$(grep '^warning' "$err" || true)"; rm -f "$err"
  if [ -n "$warn" ]; then echo "cannot trust the board from here:"; echo "$warn"; exit 2; fi
  mine=""
  while IFS=$'\t' read -r id st title nx where; do
    [ "$nx" = "po" ] || continue
    if [ "$st" = "escalated" ] && grep -q "(eskalerad $id)" .team/ORDER.md 2>/dev/null; then continue; fi
    mine="$mine$id	$st	$title"$'\n'
  done <<< "$rows"
  if [ -n "$mine" ]; then echo "board needs the PO:"; printf '%s' "$mine"; exit 0; fi
  active="$(printf '%s\n' "$rows" | awk -F'\t' 'NF && $2!="done" && $2!="closed" && $2!="needs-split"')"
  next="$(grep -m1 -E '^- \[ \] ' .team/ORDER.md 2>/dev/null || true)"
  if [ -z "$active" ] && [ -n "$next" ]; then echo "board idle — next order row:"; echo "$next"; exit 0; fi
  if [ "$t" -ge "$max" ]; then echo "nothing for po after ${max}s — run po-wait again"; exit 1; fi
  sleep "$every"; t=$((t + every))
done
