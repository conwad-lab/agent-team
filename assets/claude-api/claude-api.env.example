# ~/.config/agent-team/claude-api.env — config of the Claude API loops (team/CLAUDE-API.md).
# bin/claude-api-install writes this file; edit it by hand only to change a value below.

# 1 = this host runs the loops. Exactly one host has 1 at a time.
ENABLED=1
HOST=macbook
HUMAN=Conny
# Never under ~/WebProjects or a vault: the poller and installer refuse.
WORK_DIR="$HOME/agent-team-builds"
# Team repos whose PRs the judge loop takes, space-separated owner/name.
REPOS="conwad-lab/mondmodel conwad-lab/tb-site conwad-lab/dignami-aos conwad-lab/dignify-your-craft conwad-lab/unghud-site conwad-lab/relationsmodellen-site"
# Repos the planner loop writes stories and plans for (empty: none).
PLAN_REPOS="conwad-lab/mondmodel conwad-lab/tb-site conwad-lab/dignami-aos conwad-lab/dignify-your-craft conwad-lab/unghud-site conwad-lab/relationsmodellen-site"
# Logins whose `judge-claude: review` comments count as orders.
ALLOW="conwad-lab"
JUDGE_MODEL=claude-sonnet-5-5
PLAN_MODEL=claude-opus-5-5
# The loops bridge the time the Max plan is spent: from this UTC date no new judge or planner run starts (merges and
# orders already in flight finish). Empty: no end date. Max resets Sunday 2026-11-29.
ACTIVE_UNTIL=2026-11-29
# Dollar limits: one run, and all runs of one UTC day. At the daily cap the loops stop until tomorrow.
JUDGE_BUDGET_USD=3
PLAN_BUDGET_USD=5
DAILY_CAP_USD=20
RUN_LIMIT_MIN=40
# A repo is planned for at most this often.
PLAN_EVERY_HOURS=6
# An approved PR whose checks are not green after this long is left to the Coordinator.
MERGE_WAIT_HOURS=3
# Keychain items: the Anthropic API key, and the fine-grained GitHub token shared with the Codex CLI poller.
KEY_ITEM=agent-team-claude-api-key
KEYCHAIN_ITEM=agent-team-codex-cli
