# ~/.config/agent-team/codex-cli.env — the host poller's config (team/CODEX-CLI.md).
# Everything host-specific lives here and in the launchd job; no repo, rule or story names the host.
# bin/codex-cli-install writes this file; edit it by hand only to change a value below.

# 1 = this host takes orders. Exactly one host has 1 at a time (team/CODEX-CLI.md § Move to another host).
ENABLED=1
# Shown in the claim and outcome comments: "— Coder (Codex CLI, <HOST>) on behalf of <HUMAN>".
HOST=macbook
HUMAN=Conny
# The poller's own clones and worktrees. Never under ~/WebProjects or a vault: the poller and installer refuse.
WORK_DIR="$HOME/agent-team-builds"
# Team repos whose `codex-cli` issues this host takes, space-separated owner/name.
REPOS="conwad-lab/mondmodel conwad-lab/tb-site conwad-lab/dignami-aos conwad-lab/dignify-your-craft conwad-lab/unghud-site conwad-lab/relationsmodellen-site"
# Logins whose `codex-cli: build|fix` comments count as orders: the human's and the account cloud threads post as.
ALLOW="conwad-lab"
# Codex model for an order without a `Model:` line (team/CODEX-CLI.md § Rules).
MODEL=gpt-6-astra
# Models an order may name with `Model: <name>`, space-separated name=id (the id as `codex` lists it under /model).
# An order naming anything else is bounced.
MODELS="astra=gpt-6-astra sol=gpt-6-sol"
# Limits per run: wall time, and minutes without new output in ~/.codex/sessions before the run is stopped.
RUN_LIMIT_MIN=45
STALL_MIN=10
# Keychain item (service name) holding the fine-grained GitHub token.
KEYCHAIN_ITEM=agent-team-codex-cli
