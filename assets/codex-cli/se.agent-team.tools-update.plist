<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for bin/codex-cli-install (team/MODELS.md): the script, PATH and log placeholders are filled in at install.
     03:30 local time; a Mac asleep then runs it when it wakes. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>se.agent-team.tools-update</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__SCRIPT__</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__PATH__</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__LOGS__/tools-update.out.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/tools-update.err.log</string>
</dict>
</plist>
