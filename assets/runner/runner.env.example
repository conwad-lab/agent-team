# ~/.config/agent-team/runner.env — the self-hosted runners on this host Mac (team/RUNNER.md).
# bin/runner-install writes this file; edit it by hand only to change a value below, then run the install line again.

# The GitHub account that owns the repos. The installer refuses a repo owned by anyone else.
OWNER=conwad-lab
# Shown in each runner's name (<HOST>-<repo>) and added as a label. Lower-case letters, digits and hyphens.
HOST=macbook
# Private team repos that get a runner, space-separated names without the owner. Public repos are refused.
REPOS="dignami-aos unghud-site relationsmodellen-site dignify-your-craft mondmodel"
# Runners per repo, 1 to 3. Each runner is its own isolated machine and takes one job at a time.
# Per-repo override: RUNNERS_<repo with - as _>, for example RUNNERS_mondmodel=2.
RUNNERS_PER_REPO=1
# The label workflows select (team/RUNNER.md § Rules "Label `mini`"): it names the team's host, whichever Mac it is.
LABELS=mini
# The Linux image of each machine. ubuntu-latest on GitHub is Ubuntu 24.04 (noble).
DISTRO=ubuntu:noble
